{
  "expo": {
    "name": "İş Bölümü",
    "slug": "sacak",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F3EDE3",
    "scheme": "sacak",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ilkanakar.isbolumu",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserNotificationsUsageDescription": "Fatura, ev işi, ders, sınav, emanet ve özel günlerden önce sesli ve titreşimli haber vermek için.",
        "NSCalendarsUsageDescription": "Seçtiğin iş, ders ve günleri telefon takvimine yazmak için.",
        "NSCalendarsFullAccessUsageDescription": "Seçtiğin iş, ders ve günleri telefon takvimine yazmak için.",
        "NSCalendarsWriteOnlyAccessUsageDescription": "Seçtiğin iş, ders ve günleri telefon takvimine yazmak için."
      }
    },
    "android": {
      "package": "com.ilkanakar.isbolumu",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#C65A3A"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3EDE3",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C65A3A"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3706056819475760~4227241305",
          "iosAppId": "ca-app-pub-3706056819475760~7277085631",
          "delayAppMeasurementInit": true
        }
      ],
      "expo-sharing",
      [
        "expo-calendar",
        {
          "calendarPermission": "Seçtiğin iş, ders ve günleri telefon takvimine yazmak için."
        }
      ]
    ]
  }
}
